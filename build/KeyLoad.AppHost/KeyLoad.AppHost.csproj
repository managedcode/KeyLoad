<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" />
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>KeyLoad.AppHost</UserSecretsId>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/KeyLoad.Abstractions/KeyLoad.Abstractions.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../../src/KeyLoad.Clustering/KeyLoad.Clustering.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../../src/KeyLoad/KeyLoad.csproj" />
    <ProjectReference Include="../../src/KeyLoad.Storage.ZoneTree/KeyLoad.Storage.ZoneTree.csproj" IsAspireProjectResource="false" />
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <InternalsVisibleTo Include="KeyLoad.LoadTests.AppHost" />
    <InternalsVisibleTo Include="KeyLoad.ComparisonHost" />
    <InternalsVisibleTo Include="KeyLoad.FunctionalTests" />
    <InternalsVisibleTo Include="KeyLoad.ClusterTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../analyzers/KeyLoad.Analyzers/KeyLoad.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" IsAspireProjectResource="false" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../build/CodeQuality/FunctionalCompilationIdentity.targets" />
</Project>
