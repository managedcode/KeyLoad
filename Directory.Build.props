<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RunAnalyzers>true</RunAnalyzers>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <KeyLoadReleaseMajor>0</KeyLoadReleaseMajor>
    <KeyLoadReleaseMinor>1</KeyLoadReleaseMinor>
    <Version>$(KeyLoadReleaseMajor).$(KeyLoadReleaseMinor).0-dev</Version>
    <Authors>ManagedCode</Authors>
    <RepositoryUrl>https://github.com/managedcode/KeyLoad</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'KeyLoad.Analyzers' and '$(MSBuildProjectName)' != 'KeyLoad.Analyzers.Tests'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/KeyLoad.Analyzers/KeyLoad.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      IsAspireProjectResource="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
