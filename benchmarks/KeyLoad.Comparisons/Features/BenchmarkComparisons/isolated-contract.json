  "unsupportedTopologies": [
    {"target":"Neo4j","nodeCounts":[3],"reason":"Neo4j Community does not provide native clustering; Enterprise licensing is excluded."},
    {"target":"SurrealDB","nodeCounts":[3],"reason":"SurrealDB Community's experimental TiKV clustering is outside the qualified native topology; only the persistent standalone server is measured."},
    {"target":"HelixDB","nodeCounts":[3],"reason":"The self-hosted HelixDB server is standalone; managed cloud high availability is outside this native comparison."}
  ]
