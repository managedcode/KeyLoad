{
  "schemaVersion": 1,
  "workerSchemaVersion": 5,
  "profile": "intensive-1k-c16",
  "targets": ["KeyLoad", "PostgreSQL + pgvector", "Qdrant", "RabbitMQ", "Redis", "Neo4j", "MongoDB", "OpenSearch", "KurrentDB", "SurrealDB", "HelixDB"],
  "nodeCounts": [1, 3],
  "crudScenarios": ["PointRead", "DocumentWrite", "DocumentUpdate", "DocumentDelete"],
