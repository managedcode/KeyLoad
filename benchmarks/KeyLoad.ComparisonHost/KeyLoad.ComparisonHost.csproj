<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);KLD0035;KLD0036;KLD0037</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <ProjectReference Include="../../build/KeyLoad.LoadTests.AppHost/KeyLoad.LoadTests.AppHost.csproj" />
    <ProjectReference Include="../KeyLoad.Comparisons/KeyLoad.Comparisons.csproj" />
    <ProjectReference Include="../../build/KeyLoad.AppHost/KeyLoad.AppHost.csproj" IsAspireProjectResource="false" />
    <Content Include="Configuration/execution.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../analyzers/KeyLoad.Analyzers/KeyLoad.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" IsAspireProjectResource="false" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerUser>app</ContainerUser>
    <ContainerWorkingDirectory>/app/</ContainerWorkingDirectory>
    <ContainerAppCommandInstruction>Entrypoint</ContainerAppCommandInstruction>
    <ContainerRepository>keyload/comparisons</ContainerRepository>
  </PropertyGroup>
  <ItemGroup>
    <ContainerAppCommandArgs Include="--output;Detailed;--maximum-parallel-tests;1;--report-trx;--results-directory;/reports/RuntimeTestResults" />
  </ItemGroup>
  <ItemGroup>
    <ContainerLabel Include="io.keyload.local.source-context-sha256" Value="$(KeyLoadContainerSourceDigest)" Condition="'$(KeyLoadContainerSourceDigest)' != ''" />
    <ContainerLabel Include="io.keyload.local.invocation" Value="$(KeyLoadContainerInvocation)" Condition="'$(KeyLoadContainerInvocation)' != ''" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../build/CodeQuality/FunctionalCompilationIdentity.targets" />
</Project>
