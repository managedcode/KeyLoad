<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <KeyLoadCoverageToolVersion>18.12.0</KeyLoadCoverageToolVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Cartograph" Version="0.1.0-alpha" />
    <PackageVersion Include="Cartograph.Catalog" Version="0.1.0-alpha" />
    <PackageVersion Include="ZoneTree" Version="2.0.6" />
    <PackageVersion Include="ZoneTree.Analytics" Version="1.0.2" />
    <PackageVersion Include="ZoneTree.FullTextSearch" Version="1.1.0" />
    <PackageVersion Include="ManagedCode.Communication" Version="10.3.21" />
    <PackageVersion Include="ManagedCode.Communication.AspNetCore" Version="10.3.21" />
    <PackageVersion Include="ManagedCode.Communication.Orleans" Version="10.3.21" />
    <PackageVersion Include="ManagedCode.TimeSeries" Version="10.1.2" />
    <PackageVersion Include="ManagedCode.Storage.FileSystem" Version="10.1.7" />
    <PackageVersion Include="ManagedCode.Storage.Server" Version="10.1.7" />
    <PackageVersion Include="ManagedCode.Orleans.Graph" Version="10.4.9" />
    <PackageVersion Include="ManagedCode.Orleans.Identity.Core" Version="10.4.2" />
    <PackageVersion Include="ManagedCode.MCPGateway" Version="2.3.3" />
    <PackageVersion Include="ManagedCode.MarkdownLd.Kb" Version="0.2.18" />
    <!-- Central transitive dependency used by Aspire and StreamJsonRpc. -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.14" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.3.0" />
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Client" Version="10.4.2" />
    <PackageVersion Include="ManagedCode.Orleans.RapidMembership" Version="10.4.6" />
    <PackageVersion Include="Microsoft.Orleans.Streaming" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Reminders" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Journaling" Version="10.4.2-alpha.1" />
    <PackageVersion Include="Microsoft.Orleans.DurableJobs" Version="10.4.2-alpha.1" />
    <PackageVersion Include="Microsoft.Orleans.Sdk" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Serialization" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Serialization.SystemTextJson" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.CodeGenerator" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.TestingHost" Version="10.4.2" />
    <!-- Orleans' existing Roslyn dependency; analyzer tests select SDK compiler assets. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Qdrant" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.4" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="TUnit" Version="1.76.45" />
    <PackageVersion Include="TUnit.Aspire" Version="1.76.45" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.1" />
    <!-- One Microsoft engine: MTP collects test processes; the same-version CLI collects owned CLUSTER containers. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.29" />
    <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
    <PackageVersion Include="KurrentDB.Client" Version="1.6.1" />
  </ItemGroup>
</Project>
