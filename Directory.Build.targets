<Project>
  <PropertyGroup>
    <KeyLoadCodeQualityDirectory Condition="'$(UseArtifactsOutput)' != 'true'">$(MSBuildThisFileDirectory)artifacts/code-quality/$(MSBuildProjectName)/$(Configuration)/$(TargetFramework)</KeyLoadCodeQualityDirectory>
    <KeyLoadCodeQualityDirectory Condition="'$(UseArtifactsOutput)' == 'true'">$(ArtifactsPath)/code-quality/$(MSBuildProjectName)/$(Configuration)/$(TargetFramework)</KeyLoadCodeQualityDirectory>
    <ErrorLog Condition="'$(ErrorLog)' == ''">$(KeyLoadCodeQualityDirectory)/diagnostics.sarif,version=2.1</ErrorLog>
  </PropertyGroup>
  <Target Name="PrepareCodeQualityReport" BeforeTargets="CoreCompile">
    <MakeDir Directories="$(KeyLoadCodeQualityDirectory)" />
  </Target>
</Project>
