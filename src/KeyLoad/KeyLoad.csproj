<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>KeyLoad.Server</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="AdminDashboard/Assets/**/*" LogicalName="KeyLoad.AdminDashboard.%(Filename)%(Extension)" />
    <Content Include="AnalyticsStore/Assets/ZoneTree.Analytics.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KeyLoad.FunctionalTests" />
    <InternalsVisibleTo Include="KeyLoad.ComparisonHost" />
    <InternalsVisibleTo Include="KeyLoad.ProcessRecoveryTests" />
    <InternalsVisibleTo Include="KeyLoad.ClusterTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../KeyLoad.Clustering/KeyLoad.Clustering.csproj" />
    <ProjectReference Include="../KeyLoad.Storage.ZoneTree/KeyLoad.Storage.ZoneTree.csproj" />
    <ProjectReference Include="../KeyLoad.Query/KeyLoad.Query.csproj" />
    <ProjectReference Include="../KeyLoad.Client/KeyLoad.Client.csproj" />
    <PackageReference Include="ManagedCode.Orleans.RapidMembership" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="ManagedCode.Communication.AspNetCore" />
    <PackageReference Include="ManagedCode.Storage.Server" />
    <PackageReference Include="ManagedCode.Storage.FileSystem" />
    <PackageReference Include="ManagedCode.MCPGateway" />
    <PackageReference Include="ManagedCode.MarkdownLd.Kb" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.Orleans.Sdk" PrivateAssets="all" />
    <PackageReference Include="ZoneTree.Analytics" />
    <PackageReference Include="ZoneTree.FullTextSearch" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../analyzers/KeyLoad.Analyzers/KeyLoad.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" IsAspireProjectResource="false" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerUser>app</ContainerUser>
    <ContainerWorkingDirectory>/app/</ContainerWorkingDirectory>
    <ContainerAppCommandInstruction>Entrypoint</ContainerAppCommandInstruction>
    <ContainerRepository>keyload/server</ContainerRepository>
  </PropertyGroup>
  <ItemGroup>
    <ContainerEnvironmentVariable Include="ASPNETCORE_HTTP_PORTS" Value="8080" />
    <ContainerEnvironmentVariable Include="KeyLoad__DataDirectory" Value="/data" />
    <ContainerPort Include="8080" Type="tcp" />
    <ContainerPort Include="11111" Type="tcp" />
  </ItemGroup>
  <ItemGroup>
    <ContainerLabel Include="io.keyload.local.source-context-sha256" Value="$(KeyLoadContainerSourceDigest)" Condition="'$(KeyLoadContainerSourceDigest)' != ''" />
    <ContainerLabel Include="io.keyload.local.invocation" Value="$(KeyLoadContainerInvocation)" Condition="'$(KeyLoadContainerInvocation)' != ''" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../build/CodeQuality/FunctionalCompilationIdentity.targets" />
</Project>
